<Window x:Class="GeminiWalletWidget.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Gemini 额度猫娘挂件"
        Width="310"
        Height="340"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        ResizeMode="NoResize"
        SizeToContent="Manual"
        Loaded="Window_Loaded"
        Closing="Window_Closing">
    <Grid x:Name="RootGrid" Background="Transparent" RenderTransformOrigin="0.5,1">
        <Grid.LayoutTransform>
            <ScaleTransform x:Name="WindowScaleTransform" ScaleX="1" ScaleY="1"/>
        </Grid.LayoutTransform>

        <Grid.RowDefinitions>
            <RowDefinition Height="132"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Dynamic Speech Bubble above Catgirl (never horizontally flipped!) -->
        <Grid x:Name="BubbleContainer"
              Grid.Row="0"
              VerticalAlignment="Bottom"
              HorizontalAlignment="Center"
              Margin="8,0,8,4"
              Opacity="0"
              Visibility="Collapsed"
              MouseEnter="BubbleContainer_MouseEnter"
              MouseLeave="BubbleContainer_MouseLeave"
              RenderTransformOrigin="0.5,1">
            <Grid.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="BubbleScale" ScaleX="0.92" ScaleY="0.92"/>
                    <TranslateTransform x:Name="BubbleTranslate" Y="6"/>
                </TransformGroup>
            </Grid.RenderTransform>

            <StackPanel HorizontalAlignment="Center">
                <Border x:Name="BubbleBorder"
                        CornerRadius="16"
                        Padding="12,8"
                        MinWidth="188"
                        MaxWidth="282"
                        BorderThickness="1.6"
                        Background="#EB19172B">
                    <Border.BorderBrush>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#A4A1FA" Offset="0"/>
                            <GradientStop Color="#F68DC7" Offset="0.52"/>
                            <GradientStop Color="#72E6FF" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.BorderBrush>
                    <Border.Effect>
                        <DropShadowEffect Color="#120B2B" BlurRadius="14" ShadowDepth="3" Opacity="0.45"/>
                    </Border.Effect>

                    <StackPanel>
                        <Grid Margin="0,0,0,2">
                            <TextBlock x:Name="BubbleTagText"
                                       Text="Gemini 剩余额度"
                                       FontSize="10.5"
                                       FontWeight="SemiBold"
                                       Foreground="#C4BFFD"
                                       HorizontalAlignment="Left"/>
                            <TextBlock x:Name="BubbleBadgeText"
                                       Text=""
                                       FontSize="9.5"
                                       FontWeight="SemiBold"
                                       Foreground="#72E6FF"
                                       HorizontalAlignment="Right"/>
                        </Grid>

                        <TextBlock x:Name="BubbleMainText"
                                   Text="谷谷歌歌…"
                                   FontSize="13.5"
                                   FontWeight="Bold"
                                   Foreground="#F5F3FF"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   Margin="0,1,0,2"/>

                        <!-- Progress Bar (visible in quota mode) -->
                        <Border x:Name="BubbleProgressTrack"
                                Height="6"
                                CornerRadius="3"
                                Background="#33FFFFFF"
                                Margin="0,4,0,4"
                                Visibility="Collapsed"
                                ClipToBounds="True">
                            <Border x:Name="BubbleProgressFill"
                                    HorizontalAlignment="Left"
                                    Width="100"
                                    CornerRadius="3">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#72E6FF" Offset="0"/>
                                        <GradientStop Color="#A4A1FA" Offset="0.5"/>
                                        <GradientStop Color="#8EF0D0" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                        </Border>

                        <TextBlock x:Name="BubbleSubText"
                                   Text="点击猫娘切换额度 / 台词 / 统计"
                                   FontSize="10.5"
                                   Foreground="#B7B1D6"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <!-- Speech Bubble Tail -->
                <Polygon Points="0,0 12,0 6,8"
                         HorizontalAlignment="Center"
                         Fill="#EB19172B"
                         Stroke="#B79AF2"
                         StrokeThickness="1.2"
                         Margin="0,-1,0,0"/>
            </StackPanel>
        </Grid>

        <!-- Catgirl Mascot Stage -->
        <Grid Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,6">
            <Grid x:Name="MascotHost"
                  Width="188"
                  Height="188"
                  Cursor="Hand"
                  Background="Transparent"
                  MouseLeftButtonDown="MascotHost_MouseLeftButtonDown"
                  MouseMove="MascotHost_MouseMove"
                  MouseLeftButtonUp="MascotHost_MouseLeftButtonUp"
                  MouseRightButtonUp="MascotHost_MouseRightButtonUp"
                  RenderTransformOrigin="0.5,0.96">
                <Grid.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform x:Name="MascotFlipTransform" ScaleX="1" ScaleY="1"/>
                        <ScaleTransform x:Name="MascotSquishTransform" ScaleX="1" ScaleY="1"/>
                    </TransformGroup>
                </Grid.RenderTransform>

                <Image x:Name="MascotImage"
                       Stretch="Uniform"
                       RenderOptions.BitmapScalingMode="HighQuality"
                       SnapsToDevicePixels="True">
                    <Image.Effect>
                        <DropShadowEffect Color="#1A103D" BlurRadius="14" ShadowDepth="3" Opacity="0.35"/>
                    </Image.Effect>
                </Image>
            </Grid>

            <!-- Compact Quota Pill Badge on Catgirl Corner (always glanceable!) -->
            <Border x:Name="CornerQuotaPill"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Bottom"
                    Margin="6,0,0,6"
                    CornerRadius="10"
                    Padding="7,2.5"
                    Background="#DD1A182E"
                    BorderBrush="#99A4A1FA"
                    BorderThickness="1"
                    Cursor="Hand"
                    MouseLeftButtonUp="CornerQuotaPill_MouseLeftButtonUp"
                    ToolTip="点击查看 Gemini 额度详情">
                <TextBlock x:Name="CornerQuotaText"
                           Text="谷谷歌歌"
                           FontSize="10.5"
                           FontWeight="Bold"
                           Foreground="#EDE9FF"/>
            </Border>

            <!-- Hamburger Menu Button (optional, hideable) -->
            <Button x:Name="HamburgerButton"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Margin="0,0,6,6"
                    Width="26"
                    Height="26"
                    Content="☰"
                    FontSize="12"
                    Foreground="#F3F1FF"
                    Cursor="Hand"
                    ToolTip="菜单与设置（也可右键点击猫娘）"
                    Click="HamburgerButton_Click">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg"
                                CornerRadius="13"
                                Background="#CC1E1B36"
                                BorderBrush="#99A4A1FA"
                                BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#EE3B336B"/>
                                <Setter TargetName="Bg" Property="BorderBrush" Value="#F68DC7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </Grid>
    </Grid>
</Window>
